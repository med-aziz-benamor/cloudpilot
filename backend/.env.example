# Backend-local overrides. In Docker Compose the root .env is used via env_file.
# For running the backend directly on the host, copy to .env and use localhost hosts.
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://cp:cp@localhost:5432/cloudpilot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
FERNET_MASTER_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
OPENAI_API_KEY=
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
