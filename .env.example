# ═══════════════════════════════════════════════════════════════
# CloudPilot — environment configuration
# Copy to .env and adjust. The defaults below work out-of-the-box
# with `make dev` (Docker Compose) in DEMO_MODE.
# ═══════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-min-32-chars-long-please
DEBUG=true

# ─── Database ─────────────────────────────────────────────────
# Inside Docker Compose the host is `postgres`. For local (non-docker)
# runs use `localhost`. Production: Supabase Session Pooler on :6543.
DATABASE_URL=postgresql+asyncpg://cp:cp@postgres:5432/cloudpilot
SUPABASE_URL=
SUPABASE_KEY=

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

# ─── AI ───────────────────────────────────────────────────────
# Docker Desktop passes no GPU through on Apple Silicon, so the containerized
# Ollama runs on pure CPU — ~460s for one RAG answer on an 8-core M-series,
# which exceeds the timeout below and lands on the offline fallback. To get
# real Advisor answers, run Ollama on the host (Metal-accelerated) and use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# See docs/development.md.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
OPENAI_API_KEY=
# A 3B model on CPU needs well over the usual 30s; too low a timeout silently
# routes every answer to the offline fallback.
LLM_TIMEOUT_SECONDS=180
# ~250 words is what the system prompt asks for (≈330 tokens); the rest was
# headroom that only ever cost generation time on a CPU-bound model.
LLM_MAX_OUTPUT_TOKENS=384

# ─── Cloud Providers (demo mode if empty) ─────────────────────
DEMO_MODE=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (Vite) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development
VITE_DEMO_MODE=true

# ─── Observability ────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=cloudpilot
